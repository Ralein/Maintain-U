## 3. Database Schema Design

### 3.1 Entity Relationship Diagram

```mermaid
erDiagram
    COMPANY ||--o{ SERVICE_REQUEST : creates
    COMPANY ||--o{ SPOKESPERSON : has
    COMPANY ||--o{ MASTER_TEAM : has
    SERVICE_REQUEST ||--o{ JOB : generates
    JOB ||--o{ DAILY_ASSIGNMENT : has
    MASTER_TEAM ||--o{ MASTER_TEAM_MEMBER : contains
    TECHNICIAN ||--o{ MASTER_TEAM_MEMBER : belongs_to
    DAILY_ASSIGNMENT ||--o{ ATTENDANCE : tracks
    TECHNICIAN ||--o{ ATTENDANCE : has
    ATTENDANCE ||--o| SUBSTITUTION : may_have
    TECHNICIAN ||--o{ SALARY_RECORD : earns
    JOB ||--o{ STATUS_UPDATE : has
    JOB ||--|| SIGNATURE : requires
    JOB ||--|| INVOICE : generates
    ADMIN ||--o{ JOB : manages
    TECHNICIAN ||--o{ SKILL : has
    SERVICE_REQUEST ||--o{ SKILL_REQUIREMENT : needs

    COMPANY {
        uuid id PK
        string name
        string industry_type
        string address
        string email
        string phone
        timestamp created_at
    }
    
    SPOKESPERSON {
        uuid id PK
        uuid company_id FK
        string name
        string phone
        string email
        string department
    }
    
    TECHNICIAN {
        uuid id PK
        string name
        string phone
        string email
        string expertise_areas
        boolean is_available
        float daily_rate
        float rating
        timestamp registered_at
    }
    
    SKILL {
        uuid id PK
        uuid technician_id FK
        string skill_name
        string category
        int proficiency_level
    }
    
    SERVICE_REQUEST {
        uuid id PK
        uuid company_id FK
        uuid spokesperson_id FK
        string request_type
        string description
        string priority
        string status
        timestamp created_at
        timestamp preferred_date
    }
    
    MASTER_TEAM {
        uuid id PK
        uuid company_id FK
        uuid job_id FK
        string team_name
        string status
        timestamp created_at
    }
    
    MASTER_TEAM_MEMBER {
        uuid id PK
        uuid master_team_id FK
        uuid technician_id FK
        boolean is_lead
        string status
        timestamp added_at
    }
    
    DAILY_ASSIGNMENT {
        uuid id PK
        uuid job_id FK
        uuid master_team_id FK
        date work_date
        string status
        timestamp created_at
    }
    
    ATTENDANCE {
        uuid id PK
        uuid daily_assignment_id FK
        uuid technician_id FK
        string status
        boolean has_substitute
        uuid substitute_id FK
        string substitute_approval_status
        float salary_amount
        boolean salary_deducted
        timestamp check_in_time
        timestamp check_out_time
    }
    
    SUBSTITUTION {
        uuid id PK
        uuid attendance_id FK
        uuid original_technician_id FK
        uuid substitute_technician_id FK
        string reason
        string admin_decision
        boolean salary_transferred
        timestamp requested_at
        timestamp decided_at
    }
    
    SALARY_RECORD {
        uuid id PK
        uuid technician_id FK
        uuid job_id FK
        date work_date
        float base_amount
        float deductions
        float net_amount
        string status
        timestamp processed_at
    }
    
    JOB {
        uuid id PK
        uuid request_id FK
        uuid admin_id FK
        uuid master_team_id FK
        uuid lead_technician_id FK
        string status
        string location_address
        float latitude
        float longitude
        timestamp scheduled_at
        timestamp started_at
        timestamp completed_at
    }
    
    STATUS_UPDATE {
        uuid id PK
        uuid job_id FK
        uuid technician_id FK
        string update_type
        string description
        string evidence_url
        timestamp created_at
    }
    
    SIGNATURE {
        uuid id PK
        uuid job_id FK
        string supervisor_name
        string image_url
        timestamp signed_at
    }
    
    INVOICE {
        uuid id PK
        uuid job_id FK
        float labor_cost
        float material_cost
        float total_amount
        string status
        string pdf_url
        timestamp generated_at
        timestamp sent_at
    }
```

